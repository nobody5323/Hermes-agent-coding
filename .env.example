# LLM patch generator
AI_CODING_LLM_API_KEY=
AI_CODING_LLM_BASE_URL=https://api.deepseek.com
AI_CODING_LLM_MODEL=deepseek-v4-pro

# Optional production RAG services. Leave unset for local zero-dependency retrieval.
AI_CODING_RAG_BACKEND=local
AI_CODING_QDRANT_URL=http://localhost:6333
AI_CODING_QDRANT_API_KEY=
AI_CODING_QDRANT_COLLECTION=ai_coding_chunks
AI_CODING_QDRANT_INDEX_ON_RETRIEVE=true

# OpenAI-compatible embeddings endpoint.
AI_CODING_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_CODING_EMBEDDING_API_KEY=
AI_CODING_EMBEDDING_MODEL=text-embedding-3-small
AI_CODING_EMBEDDING_DIMENSIONS=1536

# Optional generic reranker endpoint, e.g. Jina/Cohere-style JSON rerank API.
AI_CODING_RERANKER_URL=
AI_CODING_RERANKER_API_KEY=
AI_CODING_RERANKER_MODEL=
